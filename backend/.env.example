# ==============================================================================
# Parallax-Eval Environment Configuration
# ==============================================================================

# General
PROJECT_NAME="Parallax-Eval"
ENVIRONMENT="development"

# Database Configuration
# Local SQLite default (zero-setup):
DATABASE_URL="sqlite+aiosqlite:///./parallax_eval.db"
# Docker PostgreSQL production example:
# DATABASE_URL="postgresql+asyncpg://parallax:parallax_secret_password@localhost:5432/parallax_eval"

# LLM Gateway Settings
# Set USE_MOCK_LLM=True for 100% offline, deterministic testing with zero API charges
USE_MOCK_LLM=True

# Live LLM Providers (Required if USE_MOCK_LLM=False)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Models
DEFAULT_TARGET_MODEL="gpt-4o-mini"
DEFAULT_JUDGE_MODEL="gpt-4o-mini"

# Concurrency & Resilience
MAX_CONCURRENT_EVALS=3
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# CORS
CORS_ORIGINS=["*"]

